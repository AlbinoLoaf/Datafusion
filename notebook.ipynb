    "# Merging two sets used for comparing LPB vs HOG for images features extraction\n",
    "\n",
    "set2_path = os.path.join(DATA_DIR, 'Set2_linked.pkl')\n",
    "set2_df = pd.read_pickle(set2_path)\n",
    "\n",
    "# Dropping duplicate to get unique images and their corresponding wear values\n",
    "set1_image_group = (\n",
    "    set1_df\n",
    "    .drop_duplicates(\"image_path\")[[\"image_path\", \"wear\"]]\n",
    "    .dropna()\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "set2_image_group = (\n",
    "    set2_df\n",
    "    .drop_duplicates(\"image_path\")[[\"image_path\", \"wear\"]]\n",
    "    .dropna()\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "merged = pd.concat([set1_image_group, set2_image_group], ignore_index=True)\n",
    "merged['class'] = merged['wear'].apply(lambda x: 1 if x >= 120 else 0)"
   ]
