    "def svm(features, X_train, X_test, y_train, y_test):\n",
    "    svm_model = SVC(kernel='linear')\n",
    "    \n",
    "    svm_model.fit(X_train, y_train)\n",
    "    y_pred = svm_model.predict(X_test)\n",
    "    accuracy = mean_squared_error(y_test, y_pred)\n",
    "\n",
    "    print(f\"\\nSVM Accuracy {features}: {accuracy:.4f}\")\n",
    "\n",
    "    svm = SVR(kernel='rbf')\n",
    "\n",
    "    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "    \n",
    "    # FIX: Changed 'y' to 'y_train' here\n",
    "    cv_scores = cross_val_score(svm, X_train, y_train, cv=cv, scoring='accuracy')\n",
    "\n",
    "    print(f\"-- 5-Fold Cross-Validation Scores: {cv_scores}\")\n",
    "    print(f\"-- Mean CV Accuracy: {cv_scores.mean():.3f} (+/- {cv_scores.std():.3f})\")\n",
    "svm(\"lbp\",X_train_lbp, X_test_lbp, y_train_lbp, y_test_lbp)\n",
    "svm(\"hog\",X_train_hog, X_test_hog, y_train_hog, y_test_hog)"
   ]
