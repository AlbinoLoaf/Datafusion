    "# Cache image features for all sets, have to generate a new df \n",
    "# Set_linked have repetition of image file, saving it in another df saves memory and process time\n",
    "for file in os.listdir(DATA_DIR):\n",
    "    if file.startswith(\"Set\") and file.endswith(\"_linked.pkl\"):\n",
    "        set_path = os.path.join(DATA_DIR, file)\n",
    "        \n",
    "        set_name = file.split(\"_linked.pkl\")[0]\n",
    "\n",
    "        # Check if already done\n",
    "        target_pkl = os.path.join(DATA_DIR, f\"{set_name}_image_features.pkl\")\n",
    "        if os.path.exists(target_pkl):\n",
    "            print(f\"[{set_name}] Cache exists. Skipping.\")\n",
    "            continue\n",
    "        \n",
    "        image_feature_df = process_set_images(set_path)\n",
    "        image_feature_df.to_pickle(target_pkl)\n",
    "        print(f\"[{set_name}] Saved image features to {target_pkl}\")"
   ]
