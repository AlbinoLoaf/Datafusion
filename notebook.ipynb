    "# Load pre-trained ResNet50 and modify the final layer for regression\n",
    "resnet_model = resnet50(weights=ResNet50_Weights.DEFAULT)\n",
    "# Freeze weights\n",
    "for param in resnet_model.parameters():\n",
    "    param.requires_grad = False\n",
    "\n",
    "num_input_ftrs = resnet_model.fc.in_features\n",
    "\n",
    "resnet_model.fc = nn.Sequential(\n",
    "    nn.Linear(num_input_ftrs, 512),\n",
    "    nn.ReLU(),\n",
    "    nn.Dropout(0.3), \n",
    "    nn.Linear(512, 128),\n",
    "    nn.ReLU(),\n",
    "    nn.Dropout(0.2),\n",
    "    nn.Linear(128, 1) \n",
    ")\n",
    "\n",
    "optimizer = optim.Adam(resnet_model.parameters(), lr=learning_rate, weight_decay=1e-4)\n",
    "\n",
    "scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='min',factor=0.5, patience=5)"
   ]
