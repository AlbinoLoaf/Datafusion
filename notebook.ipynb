    "labels_df = labels_df.dropna()\n",
    "\n",
    "column_names = ['accel', 'acoustic', 'force_x', 'force_y', 'force_z']\n",
    "training_df = pd.DataFrame(columns=['wear', 'image_hog', 'image_lbp'] + [f\"wavelet_{feature}\" for feature in column_names])\n",
    "\n",
    "for idx, row in labels_df.iterrows():\n",
    "    features = [row['wear']]\n",
    "    set_name = f\"Set{str(row['Set'])}\"\n",
    "    set_path = os.path.join(DATA_DIR, set_name)\n",
    "    sensor_filename = row['SensorName']\n",
    "    \n",
    "    image_path = os.path.join(DATA_DIR, set_name, 'images', row['ImageName'])\n",
    "    image_path = str(Path(image_path)).replace(\"\\\\\", \"/\") # Ensure consistent path format across OS, will run well on linux but window paths mess up\n",
    "    images_ftr_path = os.path.join(DATA_DIR, f\"Set{row['Set']}_image_features.pkl\")\n",
    "    \n",
    "    try:\n",
    "        img_ftr_df = pd.read_pickle(images_ftr_path).set_index('image_path')\n",
    "        hog_feature = img_ftr_df.loc[image_path, 'hog_features']\n",
    "        lbp_feature = img_ftr_df.loc[image_path, 'lbp_features']\n",
    "        features.append(hog_feature)\n",
    "        features.append(lbp_feature)\n",
    "\n",
    "    except KeyError:\n",
    "        print(f\"HOG or LBP features missing for {image_path}. Skipping this sample.\")\n",
    "        continue \n",
    "\n",
    "    sensor_data = pd.read_csv(os.path.join(DATA_DIR, set_name, 'sensordata', sensor_filename))\n",
    "    sensor_data.columns = column_names + ['timestamp']\n",
    "\n",
    "    for feature in ['accel', 'acoustic', 'force_x', 'force_y', 'force_z']:\n",
    "        wavelet_features = extract_wavelet_packet_features(sensor_data[feature])\n",
    "        features.append(wavelet_features)\n",
    "\n",
    "    training_df.loc[idx] = features"
   ]
